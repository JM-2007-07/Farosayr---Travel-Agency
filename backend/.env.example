PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# Example only — replace with your real local PostgreSQL credentials.
# Never commit a real DATABASE_URL with actual credentials to Git.
DATABASE_URL="postgresql://postgres:password@localhost:5432/farosayr"

# Generate your own secret — do NOT reuse this example value anywhere real.
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-development-only-secret"
JWT_EXPIRES_IN=7d
