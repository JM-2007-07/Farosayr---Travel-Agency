PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# Example only — replace with your real local PostgreSQL credentials.
# Never commit a real DATABASE_URL with actual credentials to Git.
DATABASE_URL="postgresql://postgres:password@localhost:5432/farosayr"

# Generate your own secret — do NOT reuse this example value anywhere real.
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-development-only-secret"
JWT_EXPIRES_IN=7d

# Telegram bot + admin notifications (optional — see ../docs/telegram.md).
# Leave empty to disable: the rest of the API works without them.
# Never commit real values; set them in .env locally and in Vercel for production.
TELEGRAM_BOT_TOKEN=8906785368:AAF2DsZGqqsNod-rUuLQfxyttgsviEwRAxM
TELEGRAM_ADMIN_CHAT_ID=1981063989
# Random string, 1–256 chars of A–Z a–z 0–9 _ -
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=Farosayr_Telegram_2026_Webhook_8xK29mQp
