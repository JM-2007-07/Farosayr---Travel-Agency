PORT=5000
NODE_ENV=development
# Website origin(s) allowed to call the API with cookies (CORS + CSRF).
# Comma-separated; the FIRST one is the canonical site URL used in links.
# Production example: CLIENT_URL=https://farosayr.com
CLIENT_URL=http://localhost:5173
API_PREFIX=/api

# Example only — replace with your real LOCAL PostgreSQL credentials.
# Never commit a real DATABASE_URL. Do not point a development .env at the
# production database (see docs/DEVELOPMENT.md).
DATABASE_URL="postgresql://postgres:password@localhost:5432/farosayr"

# At least 32 random characters. Generate your own — never reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-development-only-secret"
JWT_EXPIRES_IN=7d
# Auth cookie SameSite: lax | strict | none. Leave empty for the default
# (development: lax; production: none). Production uses lax once the API is
# served from api.farosayr.tj — see docs/DEPLOYMENT.md §7.
AUTH_COOKIE_SAMESITE=

# Telegram bot + admin notifications (optional — see ../docs/TELEGRAM.md).
# Leave empty to disable: the rest of the API works without them.
# Never commit real values; set them in .env locally and in Vercel for production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# 16–256 random chars of A–Z a–z 0–9 _ -
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Demo seed (npm run prisma:seed) — development only, see docs/DEVELOPMENT.md.
# Password for all seeded demo users; leave empty to get a random one printed.
SEED_DEV_PASSWORD=
# The seed refuses non-local databases unless this is "true".
SEED_ALLOW_REMOTE_DATABASE=
